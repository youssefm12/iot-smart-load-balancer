      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB"
          },
          "query": "from(bucket: \"server-metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"server_metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"load_score\")\n  |> filter(fn: (r) => r._value > 80)\n  |> pivot(rowKey:[\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"server_id\", \"load_score\"])\n  |> rename(columns: {\"_time\": \"Time\", \"server_id\": \"Server\", \"load_score\": \"Load %\"})\n  |> sort(columns: [\"Time\"], desc: true)",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "showNodes": false,
          "reducer": [
            "sum"
          ]
        }
      },
