[
  {
    "id": "mqtt-broker-config",
    "type": "mqtt-broker",
    "name": "Local Mosquitto",
    "broker": "broker",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "compatmode": true,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },
  {
    "id": "mqtt-in-node",
    "type": "mqtt in",
    "z": "main",
    "name": "📨 MQTT Metrics",
    "topic": "servers/+/metrics",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt-broker-config",
    "nl": false,
    "rap": true,
    "rh": 0,
    "wires": [["parse-json"]]
  },
  {
    "id": "parse-json",
    "type": "json",
    "z": "main",
    "name": "Parse JSON",
    "property": "payload",
    "action": "",
    "pretty": false,
    "wires": [["lb-rule", "influx-format"]]
  },
  {
    "id": "lb-rule",
    "type": "function",
    "z": "main",
    "name": "⚡ Load Balancing Logic",
    "func": "const d = msg.payload;\n\nif (d.load_score <= 80) {\n  return null;\n}\n\nconst now = Date.now();\nglobal.states = global.states || {};\nglobal.lastAction = global.lastAction || {};\nglobal.states[d.server_id] = d.load_score;\n\n// 30s Cooldown\nif ((now - (global.lastAction[d.server_id] || 0)) < 30000) {\n  return null;\n}\n\n// Find Target\nconst others = Object.entries(global.states)\n  .filter(([k, v]) => k !== d.server_id && v < 70)\n  .sort((a, b) => a[1] - b[1]);\n\nif (!others.length) {\n  return null;\n}\n\nglobal.lastAction[d.server_id] = now;\nmsg.payload = {\n  action: 'reduce_load',\n  source: d.server_id,\n  target: others[0][0],\n  load_score: d.load_score,\n  timestamp: Math.floor(now / 1000)\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "wires": [["mqtt-cmd", "mqtt-alert", "debug-lb"]]
  },
  {
    "id": "debug-lb",
    "type": "debug",
    "z": "main",
    "name": "⚡ LB Actions",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "wires": []
  },
  {
    "id": "mqtt-cmd",
    "type": "mqtt out",
    "z": "main",
    "name": "→ Publish Command",
    "topic": "loadbalancer/commands",
    "qos": "1",
    "retain": "false",
    "broker": "mqtt-broker-config",
    "wires": []
  },
  {
    "id": "mqtt-alert",
    "type": "mqtt out",
    "z": "main",
    "name": "→ Publish Alert",
    "topic": "loadbalancer/alerts",
    "qos": "1",
    "retain": "false",
    "broker": "mqtt-broker-config",
    "wires": []
  },
  {
    "id": "influx-format",
    "type": "function",
    "z": "main",
    "name": "📊 Format Line Protocol",
    "func": "const d = msg.payload;\nconst line = `server_metrics,server_id=${d.server_id} cpu=${d.cpu},ram=${d.ram},network_mbps=${d.network},load_score=${d.load_score} ${d.timestamp}`;\nmsg.payload = line;\nmsg.headers = {\n  \"Authorization\": \"Token my-super-secret-auth-token\",\n  \"Content-Type\": \"text/plain\"\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "wires": [["influx-http"]]
  },
  {
    "id": "influx-http",
    "type": "http request",
    "z": "main",
    "name": "HTTP Write to InfluxDB",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "http://influxdb:8086/api/v2/write?org=iot-org&bucket=server-metrics&precision=s",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "wires": [[]]
  }
]
